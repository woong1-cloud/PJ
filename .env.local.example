# Supabase 프로젝트 설정 > API 에서 확인
# 주의: NEXT_PUBLIC_ 접두어를 붙이지 않는다 (브라우저에 노출되면 안 됨, 서버 전용 키)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브라우저에 노출되는 공개 키 — 로그인 등 클라이언트 인증에 사용한다.
# anon key는 원래 공개되어도 되는 키다(RLS로 보호되는 게 원칙이지만, 이 앱은
# 클라이언트에서 Supabase 테이블을 직접 조회하지 않고 로그인/세션에만 쓴다).
# URL은 위 SUPABASE_URL과 같은 프로젝트를 가리킨다 — 별도 프로젝트가 아니라
# 서버용/클라이언트용으로 노출 방식만 다른 두 변수다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 가입 허용 이메일 도메인(쉼표 구분). 비워 두면 아무도 가입할 수 없다 —
# 빈 문자열은 nullish 가 아니라서 코드의 기본값으로 떨어지지 않는다.
SIGNUP_ALLOWED_DOMAINS=eland.co.kr

# ── 알림 메일(선택) ─────────────────────────────────────────────
# HOST/USER/PASS 중 하나라도 비어 있으면 메일 기능은 통째로 꺼진다.
# 인앱 알림(벨)은 이 설정과 무관하게 항상 동작한다.
#
# 메일이 나가는 경우는 셋뿐이다: 배치 대기(가입), 담당자 지정, @멘션.
# 상태 변경·일반 코멘트는 벨에만 남는다 — 다 보내면 아무도 안 읽는다.
#
# Gmail / Google Workspace
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#   SMTP_PASS 는 계정 비밀번호가 아니라 '앱 비밀번호'다(2단계 인증 필수).
#   Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 발급한다.
# Microsoft 365 는 smtp.office365.com:587, 사내 릴레이는 인프라팀 안내대로.
# 어느 쪽이든 코드는 같다 — 값만 바꾸면 된다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 받는 사람에게 보이는 발신자. 생략하면 SMTP_USER 를 쓴다.
SMTP_FROM=모아 MOA <noreply@example.com>

# 메일 본문 링크의 기준 주소. 사용자가 브라우저에 치는 주소 그대로 넣는다.
# 요청 헤더의 Host 를 쓰지 않는 이유: 프록시 뒤에서는 내부 호스트명이 잡혀
# 아무도 못 여는 링크가 만들어진다. 비우면 메일에 링크가 빠진다.
APP_BASE_URL=
